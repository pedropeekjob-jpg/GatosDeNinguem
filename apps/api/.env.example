# Leave DATABASE_URL empty to run with the in-memory demo content.
DATABASE_URL=postgresql://gn:gn@localhost:5432/gatos
# Back office password for now (at least 16 characters). Replaced by real accounts in phase 2.
ADMIN_TOKEN=change-me-to-a-long-random-string
PORT=4000
# Comma-separated origins allowed to call the API from the browser (the back office).
CORS_ORIGINS=http://localhost:5173
# When content changes, the API asks the site to refresh its pages.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-too
