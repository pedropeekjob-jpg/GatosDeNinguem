{
  "name": "@gn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed-db.ts"
  },
  "dependencies": {
    "@gn/domain": "workspace:*",
    "@gn/seo": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "prisma": "6.19.3",
    "tsup": "8.5.1",
    "tsx": "4.20.3",
    "vitest": "3.2.7"
  }
}
