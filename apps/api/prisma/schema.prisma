// Content is stored as validated JSON documents (zod schemas in @gn/domain)
// with the fields we query on promoted to columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cat {
  id        String   @id
  slug      String   @unique
  status    String
  data      Json
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id
  path      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model Post {
  id          String   @id
  slug        String   @unique
  publishedAt DateTime
  data        Json
  updatedAt   DateTime @updatedAt
}

model Partner {
  id     String  @id
  slug   String  @unique
  active Boolean @default(true)
  data   Json
}

model PartnerApplication {
  id         String   @id
  receivedAt DateTime
  data       Json
}

model AdoptionInterest {
  id         String   @id
  receivedAt DateTime
  catSlug    String?
  data       Json

  @@index([catSlug])
}

model NewsletterSignup {
  email        String   @id
  interests    String[]
  subscribedAt DateTime
}

model Shift {
  id       String   @id
  type     String
  startsAt DateTime
  endsAt   DateTime
  seriesId String?
  data     Json

  @@index([startsAt])
  @@index([seriesId])
}

model FosterPlacement {
  id      String @id
  catSlug String
  status  String
  data    Json
}

model Sponsorship {
  id      String  @id
  catSlug String
  active  Boolean @default(true)
  data    Json
}

model Redirect {
  id        String  @id
  from      String  @unique
  to        String
  permanent Boolean @default(true)
}

model Setting {
  key   String @id
  value Json
}

// ----- Helper accounts and Patinhas -----

model Account {
  id        String   @id
  email     String?  @unique
  phone     String?  @unique
  createdAt DateTime
  data      Json
}

model LoginCode {
  contact String @id
  data    Json
}

model Session {
  tokenHash String   @id
  accountId String
  expiresAt DateTime

  @@index([accountId])
}

model PatinhasEntry {
  id        String   @id
  accountId String?
  action    String
  points    Int
  at        DateTime
  sourceId  String?
  data      Json

  @@unique([accountId, sourceId])
  @@index([at])
}

model Badge {
  id   String @id
  data Json
}

model Challenge {
  id    String @id
  month String
  data  Json

  @@index([month])
}

model Redemption {
  id        String   @id
  accountId String?
  status    String
  createdAt DateTime
  data      Json

  @@index([accountId])
}

// Cuidados: team-only care data per cat.

model CatCare {
  catId     String   @id
  area      String
  data      Json
  updatedAt DateTime @updatedAt
}

model Medication {
  id     String @id
  catId  String
  data   Json

  @@index([catId])
}

model MedicationDose {
  id           String @id
  medicationId String
  /// Lisbon date "YYYY-MM-DD" and time "HH:MM" the dose was due.
  date         String
  time         String
  data         Json

  @@unique([medicationId, date, time])
  @@index([date])
}

model VetAppointment {
  id       String   @id
  catId    String
  startsAt DateTime
  status   String
  data     Json

  @@index([catId])
  @@index([startsAt])
}

model VisitNote {
  id        String   @id
  catId     String
  createdAt DateTime
  data      Json

  @@index([catId])
}

model CareAlert {
  id        String   @id
  catId     String
  createdAt DateTime
  data      Json

  @@index([createdAt])
  @@index([catId])
}

/** Uploaded photos, when UPLOAD_STORAGE=database (hosts without a persistent disk). */
model Upload {
  name        String   @id
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}
