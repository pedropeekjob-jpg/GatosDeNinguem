# Leave API_URL empty to run the site with demo content (no backend needed).
API_URL=http://localhost:4000
# Must match the API's REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me-too
# Only "true" on the real production domain. Anywhere else the site tells Google not to index it.
ALLOW_INDEXING=false
# Demo mode only: pretend today is this date so the example shifts are upcoming.
# DEMO_NOW=2026-11-01T09:00:00.000Z
